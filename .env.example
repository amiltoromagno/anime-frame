NUXT_PUBLIC_MAL_CLIENT_ID=your_client_id_here
NUXT_PUBLIC_MAL_REDIRECT_URI=http://localhost:3000/auth/callback
NUXT_MAL_CLIENT_SECRET=your_client_secret_here

# Absolute API origin for the Android/Capacitor build.
# The `build:mobile` script defaults this to https://anime-frame.pages.dev.
# Leave it unset for the web app (same-origin /api).
# NUXT_PUBLIC_API_BASE=https://anime-frame.pages.dev

# Extra allowed CORS origins, comma-separated. Needed when using Capacitor
# live reload against a LAN dev server, e.g. http://192.168.1.10:3000
# NUXT_CORS_ALLOWED_ORIGINS=http://192.168.1.10:3000
